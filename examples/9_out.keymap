/ {
    keymap {
        compatible = "zmk,keymap";

        // BEGIN macros
        esc_layerreset: esc_layerreset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to 0>;
            wait-ms = <20>;
            tap-ms = <20>;
        };

        hello: hello {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp E &kp L &kp L &kp O>;
        };

        slow_macro: slow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp B>;
        };

        pause_demo: pause_demo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &macro_wait_time 30 &kp A &macro_tap_time 50 &macro_pause_for_release &kp B &macro_release &kp LCTRL>;
        };
        // END macros

        // BEGIN keymap
        BASE {
            display-name = "BASE";
            bindings = <
&kp Q &kp W &kp E
&kp A &kp S &kp D
            >;
        };
        // END keymap
    };
};
